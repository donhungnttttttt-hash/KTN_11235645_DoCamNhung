# Configure these in a protected environment/secret store. Never put them in VITE_*.
SPRING_PROFILES_ACTIVE=release
TMS_BIND_ADDRESS=127.0.0.1
TMS_PORT=8080
TMS_DB_URL=jdbc:mysql://db.internal:3306/tms?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&sslMode=VERIFY_IDENTITY
TMS_DB_USER=tms_app
TMS_DB_PASSWORD=REPLACE_FROM_SECRET_STORE
TMS_ATTACHMENT_ROOT=/srv/tms/evidence
TMS_COOKIE_SECURE=true
TMS_BOOTSTRAP_ENABLED=false
TMS_REDMINE_ENABLED=false
# One-time bootstrap only; disable after confirming the first administrator.
# TMS_BOOTSTRAP_USERNAME=...
# TMS_BOOTSTRAP_PASSWORD=...
# TMS_BOOTSTRAP_DISPLAY_NAME=...
