  "components": {
    "schemas": {
      "CreateCycle": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 32,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$"
          },
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1
          },
          "milestoneId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "nullable": true
          }
        },
        "required": [
          "code",
          "name"
        ]
      },
      "Version": {
        "type": "object",
        "properties": {
          "expectedVersion": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        },
        "required": [
          "expectedVersion"
        ]
      },
      "Configuration": {
        "type": "object",
        "properties": {
          "environmentId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "deviceId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "buildId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "expectedVersion": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        },
        "required": [
          "environmentId",
          "deviceId",
          "buildId",
          "expectedVersion"
        ]
      },
      "AddScope": {
        "type": "object",
        "properties": {
          "configurationId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "revisionIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          },
          "assigneeMembershipId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "expectedVersion": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        },
        "required": [
          "configurationId",
          "revisionIds",
          "assigneeMembershipId",
          "expectedVersion"
        ]
      },
      "Assignment": {
        "type": "object",
        "properties": {
          "assigneeMembershipId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "reason": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1
          },
          "expectedVersion": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        },
        "required": [
          "assigneeMembershipId",
          "reason",
          "expectedVersion"
        ]
      },
      "RecordAttempt": {
        "type": "object",
        "properties": {
          "resultCode": {
            "type": "string",
            "enum": [
              "OK",
              "NG",
              "P"
            ]
          },
          "buildId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "actualResult": {
            "type": "string",
            "maxLength": 8000
          },
          "reason": {
            "type": "string",
            "maxLength": 1000
          },
          "evidenceReference": {
            "type": "string",
            "maxLength": 1000
          },
          "requestKey": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{8,64}$"
          },
          "expectedVersion": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        },
        "required": [
          "resultCode",
          "buildId",
          "requestKey",
          "expectedVersion"
        ]
      },
      "Cycle": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "code": {
            "type": "string",
            "maxLength": 32
          },
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "statusCode": {
            "type": "string",
            "enum": [
              "DRAFT",
              "ACTIVE"
            ]
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "milestoneId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "nullable": true
          },
          "activatedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "runCount": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "code",
          "name",
          "statusCode",
          "version",
          "milestoneId",
          "activatedAt",
          "runCount"
        ]
      },
      "ConfigurationView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "environmentId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "deviceId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "buildId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "environmentName": {
            "type": "string",
            "maxLength": 100
          },
          "deviceName": {
            "type": "string",
            "maxLength": 100
          },
          "versionLabel": {
            "type": "string",
            "maxLength": 50
          },
          "buildNumber": {
            "type": "string",
            "maxLength": 50,
            "nullable": true
          }
        },
        "required": [
          "id",
          "environmentId",
          "deviceId",
          "buildId",
          "environmentName",
          "deviceName",
          "versionLabel",
          "buildNumber"
        ]
      },
      "RunItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "cycleId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "configurationId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "testCaseId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "revisionId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
