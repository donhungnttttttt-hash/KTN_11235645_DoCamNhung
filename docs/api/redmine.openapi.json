  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "SESSION"
      },
      "csrfToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-TOKEN"
      }
    },
    "schemas": {
      "Publish": {
        "type": "object",
        "required": [
          "expectedVersion",
          "requestKey",
          "reason"
        ],
        "properties": {
          "expectedVersion": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "requestKey": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{8,100}$"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "observedFingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "Retry": {
        "type": "object",
        "required": [
          "expectedVersion",
          "reason"
        ],
        "properties": {
          "expectedVersion": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      },
      "Mapping": {
        "type": "object",
        "required": [
          "externalProjectId",
          "trackerId",
          "correlationFieldId",
          "statuses",
          "priorities"
        ],
        "properties": {
          "externalProjectId": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "trackerId": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "correlationFieldId": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "statuses": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          },
          "priorities": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          }
        }
      },
      "Configuration": {
        "type": "object",
        "required": [
          "configured",
          "canManage"
        ],
        "properties": {
          "configured": {
            "type": "boolean"
          },
          "canManage": {
            "type": "boolean"
          },
          "baseUrl": {
            "type": "string",
            "format": "uri"
          },
          "mapping": {
            "$ref": "#/components/schemas/Mapping"
          }
        }
      },
      "Snapshot": {
        "type": "object",
        "required": [
          "projectId",
          "trackerId",
          "statusId",
          "priorityId",
          "subject",
          "description",
          "marker",
          "privateIssue"
        ],
        "properties": {
          "projectId": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "trackerId": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "statusId": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "priorityId": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "subject": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "marker": {
            "type": "string",
            "format": "uuid"
          },
          "privateIssue": {
            "type": "boolean"
          }
        }
      },
      "Binding": {
        "type": "object",
        "required": [
          "id",
          "externalIssueId"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "externalIssueId": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "nullable": true
          },
          "deliveredSourceVersion": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "nullable": true
          },
          "deliveredPayload": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Snapshot"
              }
            ],
            "nullable": true
          },
          "observedPayload": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Snapshot"
              }
            ],
            "nullable": true
          },
          "observedFingerprint": {
            "type": "string",
            "nullable": true
          },
          "observedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "Delivery": {
        "type": "object",
        "required": [
          "id",
          "operation",
          "status",
          "sourceVersion",
          "reason",
          "attemptCount",
          "maxAttempts",
          "nextAttemptAt",
          "errorCode",
          "httpStatus",
          "version",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "operation": {
            "type": "string",
            "enum": [
              "PUBLISH",
              "RECONCILE"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "QUEUED",
              "RUNNING",
              "RETRY_WAIT",
              "UNCERTAIN",
              "DELIVERED",
              "FAILED",
              "CONFLICT",
              "SUPERSEDED"
            ]
          },
          "sourceVersion": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "reason": {
            "type": "string"
          },
          "attemptCount": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "maxAttempts": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "nextAttemptAt": {
            "type": "string",
            "format": "date-time"
          },
          "errorCode": {
            "type": "string",
            "nullable": true
          },
          "httpStatus": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "nullable": true
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Attempt": {
        "type": "object",
        "required": [
          "id",
          "deliveryId",
          "attemptNo",
          "outcome",
          "errorCode",
          "httpStatus",
          "occurredAt"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "deliveryId": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "attemptNo": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "outcome": {
            "type": "string"
          },
          "errorCode": {
            "type": "string",
            "nullable": true
          },
          "httpStatus": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "nullable": true
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "actor": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "State": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Configuration"
          },
          {
            "type": "object",
            "required": [
              "sourceVersion",
              "binding",
              "deliveries",
              "attempts"
            ],
            "properties": {
              "sourceVersion": {
                "type": "integer",
                "format": "int64",
                "minimum": 0
              },
              "binding": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/Binding"
                  }
                ],
                "nullable": true
              },
              "deliveries": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Delivery"
                }
              },
              "attempts": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Attempt"
                }
              }
            }
          }
        ]
      },
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "fieldErrors",
          "requestId"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "fieldErrors": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "requestId": {
            "type": "string"
          }
        }
      }
    }
  }
}
