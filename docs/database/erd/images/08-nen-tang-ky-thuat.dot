digraph ERD {
graph [rankdir=LR, bgcolor="white", fontname="Arial", fontsize=25, fontcolor="#173f62", pad="0.45", nodesep="0.42", ranksep="1.3", splines=polyline, outputorder=edgesfirst, newrank=true, labelloc=t, label="NỀN TẢNG KỸ THUẬT · 3 BẢNG"];
