t2 [id="table-application_info", label=<<TABLE BORDER="1" COLOR="#c1d6e7" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#edf6fc"><TR><TD COLSPAN="3" BGCOLOR="#c6e3f7" HEIGHT="36"><FONT POINT-SIZE="16" COLOR="#123f66"><B>application_info</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#8299ad" POINT-SIZE="10">CỘT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#8299ad" POINT-SIZE="10">KIỂU MYSQL</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#8299ad" POINT-SIZE="10">KHÓA / THUỘC TÍNH</FONT></TD></TR><TR><TD PORT="c0" ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#455a70">smallint</FONT></TD><TD PORT="pc0" ALIGN="LEFT"><FONT COLOR="#355f88" POINT-SIZE="11">PK</FONT></TD></TR><TR><TD PORT="c1" ALIGN="LEFT">system_key</TD><TD ALIGN="LEFT"><FONT COLOR="#455a70">varchar(32)</FONT></TD><TD PORT="pc1" ALIGN="LEFT"><FONT COLOR="#355f88" POINT-SIZE="11">UQ</FONT></TD></TR><TR><TD PORT="c2" ALIGN="LEFT">display_name</TD><TD ALIGN="LEFT"><FONT COLOR="#455a70">varchar(100)</FONT></TD><TD PORT="pc2" ALIGN="LEFT"><FONT COLOR="#355f88" POINT-SIZE="11"> </FONT></TD></TR><TR><TD PORT="c3" ALIGN="LEFT">installed_at</TD><TD ALIGN="LEFT"><FONT COLOR="#455a70">datetime(6)</FONT></TD><TD PORT="pc3" ALIGN="LEFT"><FONT COLOR="#355f88" POINT-SIZE="11">GEN</FONT></TD></TR></TABLE>>];
