t18 [id="table-flyway_schema_history", label=<<TABLE BORDER="1" COLOR="#c1d6e7" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#edf6fc"><TR><TD COLSPAN="3" BGCOLOR="#c6e3f7" HEIGHT="36"><FONT POINT-SIZE="16" COLOR="#123f66"><B>flyway_schema_history</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#8299ad" POINT-SIZE="10">CỘT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#8299ad" POINT-SIZE="10">KIỂU MYSQL</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#8299ad" POINT-SIZE="10">KHÓA / THUỘC TÍNH</FONT></TD></TR><TR><TD PORT="c0" ALIGN="LEFT">installed_rank</TD><TD ALIGN="LEFT"><FONT COLOR="#455a70">int</FONT></TD><TD PORT="pc0" ALIGN="LEFT"><FONT COLOR="#355f88" POINT-SIZE="11">PK</FONT></TD></TR><TR><TD PORT="c1" ALIGN="LEFT">version</TD><TD ALIGN="LEFT"><FONT COLOR="#455a70">varchar(50)</FONT></TD><TD PORT="pc1" ALIGN="LEFT"><FONT COLOR="#355f88" POINT-SIZE="11">NULL</FONT></TD></TR><TR><TD PORT="c2" ALIGN="LEFT">description</TD><TD ALIGN="LEFT"><FONT COLOR="#455a70">varchar(200)</FONT></TD><TD PORT="pc2" ALIGN="LEFT"><FONT COLOR="#355f88" POINT-SIZE="11"> </FONT></TD></TR><TR><TD PORT="c3" ALIGN="LEFT">type</TD><TD ALIGN="LEFT"><FONT COLOR="#455a70">varchar(20)</FONT></TD><TD PORT="pc3" ALIGN="LEFT"><FONT COLOR="#355f88" POINT-SIZE="11"> </FONT></TD></TR><TR><TD PORT="c4" ALIGN="LEFT">script</TD><TD ALIGN="LEFT"><FONT COLOR="#455a70">varchar(1000)</FONT></TD><TD PORT="pc4" ALIGN="LEFT"><FONT COLOR="#355f88" POINT-SIZE="11"> </FONT></TD></TR><TR><TD PORT="c5" ALIGN="LEFT">checksum</TD><TD ALIGN="LEFT"><FONT COLOR="#455a70">int</FONT></TD><TD PORT="pc5" ALIGN="LEFT"><FONT COLOR="#355f88" POINT-SIZE="11">NULL</FONT></TD></TR><TR><TD PORT="c6" ALIGN="LEFT">installed_by</TD><TD ALIGN="LEFT"><FONT COLOR="#455a70">varchar(100)</FONT></TD><TD PORT="pc6" ALIGN="LEFT"><FONT COLOR="#355f88" POINT-SIZE="11"> </FONT></TD></TR><TR><TD PORT="c7" ALIGN="LEFT">installed_on</TD><TD ALIGN="LEFT"><FONT COLOR="#455a70">timestamp</FONT></TD><TD PORT="pc7" ALIGN="LEFT"><FONT COLOR="#3