# Copy to .env.mysql.local and configure your existing database, or use Initialize-NativeMySql.ps1.
# Native configuration for mvn spring-boot:run. No Docker/.env needed.
TMS_MYSQL_HOST=127.0.0.1
TMS_MYSQL_PORT=3307
TMS_DB_NAME=tms
TMS_MYSQL_CLIENT=C:\Program Files\MySQL\MySQL Server 9.7\bin\mysql.exe
TMS_DB_USER=tms_app
TMS_DB_PASSWORD=replace_with_your_database_password
# Optional separate Flyway account. If omitted, local profile uses the DB account above.
# That account must be allowed to create/alter tables in this schema.
# TMS_MIGRATION_USER=tms_migrator
# TMS_MIGRATION_PASSWORD=replace_with_migration_password
TMS_REDMINE_ENABLED=false
TMS_BOOTSTRAP_ENABLED=false
TMS_BOOTSTRAP_USERNAME=admin.local
# Local V20 provides syp.demo.admin / @test1234 (see docs/database/demo-v20.md).
# Optional bootstrap for a database without the local demo: enable and set 12+ characters.
# Bootstrap does not overwrite accounts in an existing database.
TMS_BOOTSTRAP_PASSWORD=
TMS_BOOTSTRAP_DISPLAY_NAME=Admin local
