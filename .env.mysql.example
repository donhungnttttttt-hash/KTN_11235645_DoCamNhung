# Copy to .env.mysql.local and configure your existing database, or use Initialize-NativeMySql.ps1.
# Native configuration for mvn spring-boot:run. No Docker/.env needed.
TMS_MYSQL_HOST=127.0.0.1
TMS_MYSQL_PORT=3307
TMS_DB_NAME=tms
TMS_MYSQL_CLIENT=C:\Program Files\MySQL\MySQL Server 9.7\bin\mysql.exe
TMS_DB_USER=tms_app
TMS_DB_PASSWORD=replace_with_your_database_password
# Optional separate Flyway account. If omitted, local profile uses the DB account above.
# That account must be allowed to create/alter tables in this schema.
# TMS_MIGRATION_USER=tms_migrator
# TMS_MIGRATION_PASSWORD=replace_with_migration_password
TMS_REDMINE_ENABLED=false
TMS_BOOTSTRAP_ENABLED=false
TMS_BOOTSTRAP_USERNAME=admin.local
# Local V20 provides syp.demo.admin / @test1234 (see docs/database/demo-v20.md).
# Optional bootstrap for a database without the local demo: enable and set 12+ characters.
# Bootstrap does not overwrite accounts in an existing database.
TMS_BOOTSTRAP_PASSWORD=
TMS_BOOTSTRAP_DISPLAY_NAME=Admin local

# Optional server-side OpenAI connection. The key's display name (e.g. project) is arbitrary.
# Never put the key in Frontend/VITE_* or commit .env.mysql.local.
OPENAI_API_KEY=
TMS_OPENAI_ENABLED=false
TMS_OPENAI_MODEL=gpt-4.1-mini
# Server-only: HTTPS /v1 endpoint; approved hosts are api.openai.com and caheoai.com.
# For Caheo: TMS_OPENAI_BASE_URL=https://caheoai.com/v1 and TMS_OPENAI_MODEL=gpt-5.6-luna
TMS_OPENAI_BASE_URL=https://api.openai.com/v1
TMS_OPENAI_TIMEOUT_SECONDS=20
TMS_OPENAI_MAX_OUTPUT_TOKENS=1536
# Per backend process, per UTC minute; automatically resets, not a monthly budget.
TMS_OPENAI_REQUEST_LIMIT=20
# Temporary AI output: UTC expiry, hourly cleanup; never applied to business data automatically.
TMS_AI_DRAFT_RETENTION_DAYS=7
TMS_AI_PROJECT_DAILY_LIMIT=20
TMS_AI_DRAFT_CLEANUP_CRON=0 0 * * * *

# Optional local providers; neither downloads models nor calls inference on startup.
# Configure-LocalAi.ps1 stores private ChatGPT settings in Windows User environment.
# Start-Backend loads allowlisted AI values: Process > Windows User > this selected file.
# See docs/operations/local-ai.md. Keep existing API credentials/configuration above.
TMS_BIND_ADDRESS=127.0.0.1
TMS_OLLAMA_ENABLED=false
TMS_OLLAMA_URL=http://127.0.0.1:11434
# For manual setup only, supply the original complete settings outside git:
# TMS_CHATGPT_LOCAL_ENABLED=false
# TMS_CHATGPT_OWNER_ID=<identity_users.id, not username>
# TMS_CHATGPT_HOST_ID=urn:uuid:<stable random UUID>
# TMS_CHATGPT_VAULT_PATH=<absolute owner-only directory outside checkout>
# TMS_CHATGPT_VAULT_KEY=<base64 of 32 cryptographically random bytes>
TMS_AI_CHAT_USER_DAILY_LIMIT=20
TMS_AI_CHAT_CLEANUP_CRON=0 10 * * * *
