# LEGACY DOCKER ONLY: 3310 is the old Docker host port, not native MySQL.
# For mvn spring-boot:run use .env.mysql.local (copy .env.mysql.example), default 3307.
# Generate legacy values with scripts/Initialize-Local.ps1. Do not commit .env.
MYSQL_ROOT_PASSWORD=replace_with_random_secret
TMS_DB_PASSWORD=replace_with_random_secret
TMS_MIGRATION_PASSWORD=replace_with_random_secret
TMS_MYSQL_PORT=3310
# Optional: scripts/Initialize-Auth.ps1 generates local bootstrap credentials.
TMS_BOOTSTRAP_ENABLED=false
TMS_BOOTSTRAP_USERNAME=admin.local
TMS_BOOTSTRAP_PASSWORD=replace_with_random_secret
TMS_BOOTSTRAP_DISPLAY_NAME=Admin local
TMS_SESSION_TIMEOUT=30m
# Redmine is opt-in. Local sandbox scripts store credentials/mapping in ignored .env.redmine-state.local.
# For an operator-managed environment, supply these variables on the server only.
TMS_REDMINE_ENABLED=false
TMS_REDMINE_BASE_URL=
TMS_REDMINE_API_KEY=
TMS_REDMINE_MAPPING_FILE=
TMS_REDMINE_WORKER_ENABLED=true
