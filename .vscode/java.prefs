# Shared external null contracts also apply when JDT LS stores project metadata outside this repository.
# The .eea files live under src/main/java so editor reconciliation can discover them as package resources.
org.eclipse.jdt.core.builder.annotationPath.allLocations=enabled
# Spring MVC resolves unnamed request/path parameters from bytecode metadata.
org.eclipse.jdt.core.compiler.codegen.methodParameters=generate
