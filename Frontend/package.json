{
  "name": "system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:execution:coverage": "vitest run --config vitest.execution.config.js --coverage",
    "test:work-items:coverage": "vitest run --config vitest.work-items.config.js --coverage",
    "test:retest:coverage": "vitest run --config vitest.retest.config.js --coverage",
    "test:reporting:coverage": "vitest run --config vitest.reporting.config.js --coverage",
    "test:integration:coverage": "vitest run --config vitest.integration.config.js --coverage",
    "test:hardening:coverage": "vitest run --config vitest.hardening.config.js --coverage"
  },
  "dependencies": {
    "chart.js": "^4.4.7",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "4.1.11",
    "autoprefixer": "^10.4.20",
    "jsdom": "26.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7",
    "vitest": "4.1.11"
  }
